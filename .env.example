# Required: token of YOUR bot from @BotFather
TELEGRAM_TOKEN=

# Optional
# DATA_DIR=/data                # where bot.db and secret.key live (keep it on a volume)
# ALLOWED_USERS=123456,789012   # Telegram user IDs let in without admin approval
# POLL_INTERVAL=180             # default seconds between checks per user
# MIN_POLL_INTERVAL=60          # users can't go below this in /settings
# LOG_LEVEL=INFO
